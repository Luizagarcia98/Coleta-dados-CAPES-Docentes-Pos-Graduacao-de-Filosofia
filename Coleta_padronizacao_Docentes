##PADRONIZACAO DOS DADOS CAPES DOCENTES##

#Alteracao de nome de colunas
dados2004_2012 <- dados2004_2012 %>%
  rename(DS_TIPO_VINCULO_DOCENTE_IES = DS_TIPO_NATUR_VINCULO_DOCENTE,
         NM_IES_TITULACAO = NM_IES_TIT_MAX_DOCENTE)

#Criar a coluna AN_INICIO_VINCULO_DOCENTE
dados2013 <- dados2013 %>% mutate(AN_INICIO_VINCULO_DOCENTE = NA_integer_)
dados2014 <- dados2014 %>% mutate(AN_INICIO_VINCULO_DOCENTE = NA_integer_)
