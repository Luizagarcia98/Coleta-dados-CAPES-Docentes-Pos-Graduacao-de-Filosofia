dados2023 <- dados2023 %>% mutate(AN_INICIO_VINCULO_DOCENTE = NA_integer_)
dados2024 <- dados2024 %>% mutate(AN_INICIO_VINCULO_DOCENTE = NA_integer_)

#Reunir em uma unica tabela
Docentes <- bind_rows(dados2004_2012, dados2013, dados2014,
                      dados2015, dados2016, dados2017, dados2018,
                      dados2019, dados2020, dados2021,dados2022,
                      dados2023, dados2024)

#Remover professores visitantes
Docentes <- Docentes %>%
  filter(DS_CATEGORIA_DOCENTE == "PERMANENTE" | DS_CATEGORIA_DOCENTE == "COLABORADOR")

#Preencher AN_INICIO_VINCULO_DOCENTE com NA
Docentes <- Docentes %>%
  # Ordenar por nome
  arrange(NM_DOCENTE, AN_BASE) %>%
  # Agrupar por nome para preencher os dados de cada pessoa
  group_by(NM_DOCENTE) %>%
  # Preencher NA's com o valor anterior do mesmo grupo (para mês e ano)
  fill(AN_INICIO_VINCULO_DOCENTE, .direction = "down") %>%
  # Remover o agrupamento
  ungroup()

#Deixar apenas uma linha por docente
unique_docentes <- Docentes %>%
  group_by(NM_DOCENTE) %>%
  filter(row_number() == n()) %>%
  ungroup()

#Atribuindo genero pelo nome
install.packages("genderBR")
library(genderBR)

unique_docentes$GENERO <- get_gender(unique_docentes$NM_DOCENTE)
#Mudar para portugues
unique_docente <- unique_docente %>%
  mutate(GENERO = recode(GENERO,
                         "Male" = "HOMEM",
                         "Female" = "MULHER"))

#Salvando planilha
write_xlsx(unique_docente, "Docentes.xlsx")
